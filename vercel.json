{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "buildCommand": "npx vite build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(assets|sw.js|registerSW.js|manifest.webmanifest|favicon-16.png|favicon-32.png|favicon-180.png|apple-touch-icon.png|icon-192.png|icon-512.png|play-store-icon.png|adaptive-icon.png|icon-192.svg|icon-512.svg|favicon.svg|icons.svg|hero.png)(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
